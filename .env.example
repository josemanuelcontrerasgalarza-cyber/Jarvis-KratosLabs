# Opción A (recomendada): Mistral Large 4 vía NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
# Esfuerzo de razonamiento: low | medium | high
NVIDIA_REASONING_EFFORT=medium

# Opción B: API oficial de Mistral (se usa solo si no hay NVIDIA_API_KEY)
# Clave de API de Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Modelo (por defecto mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest

# Cadena de conexión de Neon (https://console.neon.tech) — usa la "pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Contraseña para entrar a tu Jarvis. Si se deja vacía, la app queda ABIERTA (solo para desarrollo local).
JARVIS_ACCESS_KEY=

# Cómo quieres que Jarvis te llame
JARVIS_USER_NAME=señor
